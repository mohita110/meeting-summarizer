# ---- Choose your ASR (speech-to-text) provider ----
# Options: openai_whisper_api | groq | local_whisper | azure
ASR_PROVIDER=groq

# ---- Choose your LLM provider for summarization ----
# Options: anthropic | openai | groq
LLM_PROVIDER=groq

# ---- API Keys (only fill in the ones you need) ----
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Free at console.groq.com — covers both ASR (Whisper) and LLM (Llama) if used for both
GROQ_API_KEY=your-groq-api-key-here

# Azure Speech (only needed if ASR_PROVIDER=azure)
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=your-azure-region-here

# ---- App settings ----
DATABASE_URL=sqlite:///./meetings.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200
